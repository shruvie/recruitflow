# ---------------------------------------------------------------------------
# RecruitFlow — example environment.
# Copy to `.env` and adjust. NEVER commit `.env`.
#
# Every value here is read once, at startup, by a validated config module
# (Zod schema). Application code never reads process.env directly.
# See docs/engineering-rules.md.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ------------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://recruitflow:recruitflow@localhost:5432/recruitflow?schema=public
# Separate URL used by integration tests (schema is dropped/recreated).
DATABASE_TEST_URL=postgresql://recruitflow:recruitflow@localhost:5432/recruitflow_test?schema=public
DATABASE_POOL_MAX=20

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# --- Cache / Queue --------------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=bullmq          # bullmq | inmemory
CACHE_DRIVER=redis           # redis | inmemory

# --- Storage --------------------------------------------------------------
STORAGE_DRIVER=local         # local | s3
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=recruitflow-documents
S3_ACCESS_KEY_ID=recruitflow
S3_SECRET_ACCESS_KEY=recruitflow
S3_FORCE_PATH_STYLE=true

# --- Email ----------------------------------------------------------------
EMAIL_DRIVER=smtp            # console | smtp | (ses/resend/postmark later)
EMAIL_FROM="RecruitFlow <no-reply@recruitflow.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Search ---------------------------------------------------------------
SEARCH_DRIVER=postgres       # postgres | (opensearch/hybrid later)

# --- AI (optional; RecruitFlow must run fully without these) --------------
AI_ENABLED=false
AI_PROVIDER=anthropic        # anthropic | ... (provider-agnostic; driver chosen here)
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
AI_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT_MS=60000
# Per-organization guardrails, enforced in the orchestrator.
AI_ORG_DAILY_TOKEN_BUDGET=2000000
AI_ORG_RATE_LIMIT_PER_MINUTE=30

# --- MCP (reserved — not implemented in the base build) -------------------
MCP_ENABLED=false

# --- RAG (reserved — not implemented in the base build) -------------------
RAG_ENABLED=false
VECTOR_STORE_DRIVER=none     # none | pgvector | qdrant | pinecone | ...
EMBEDDING_PROVIDER=none

# --- Auth (reserved — implemented separately by the project owner) --------
# The base build ships an AuthProvider interface plus a development-only
# identity driver. Real auth (OAuth/JWT/MFA/SSO) plugs in behind it.
AUTH_DRIVER=dev              # dev | (oauth/jwt/sso later)
AUTH_DEV_ALLOW_HEADER_IDENTITY=true

# --- Observability --------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
